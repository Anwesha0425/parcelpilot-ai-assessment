# ParcelPilot AI Support System — Environment Variables
# Copy this file to .env.local and fill in your values

# ─── REQUIRED ────────────────────────────────────────────────────────────────
# Get your FREE Gemini API key at: https://aistudio.google.com/apikey
# No credit card needed — Gemini 1.5 Flash is free to use
GEMINI_API_KEY=your_gemini_api_key_here

# ─── OPTIONAL ─────────────────────────────────────────────────────────────────
# JWT secret for session tokens (change in production)
JWT_SECRET=parcelpilot-dev-secret-change-in-production
